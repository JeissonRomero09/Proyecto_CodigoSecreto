<?xml version="1.0" encoding="UTF-8"?>

<!-- Importaciones de componentes de JavaFX -->
<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<!-- Pantalla principal del sistema (login / registro de jugadores) -->
<AnchorPane prefHeight="491.0" prefWidth="914.0"
	xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="co.edu.poli.CodigoOculto.Controlador.MenuPrincipalControlador">

	<children>

		<!-- Fondo principal de la pantalla -->
		<ImageView fitHeight="529.0" fitWidth="939.0" layoutX="-9.0"
			layoutY="-8.0" pickOnBounds="true" preserveRatio="true">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Fondo1.png" />
			</image>
		</ImageView>

		<!-- Panel decorativo central -->
		<ImageView fitHeight="304.0" fitWidth="360.0"
			layoutX="282.0" layoutY="16.0" opacity="0.88">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Cuadro1.png" />
			</image>
		</ImageView>

		<!-- BOTÓN: REGISTRAR JUGADOR -->
		<Button layoutX="388.0" layoutY="63.0"
			onAction="#registrarJugador" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;"
			text="Registrarse" textFill="WHITE">

			<!-- Estilo de fuente del botón -->
			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Button>

		<!-- Marco visual del campo de nombre -->
		<Rectangle arcHeight="40.0" arcWidth="40.0" height="32.0"
			layoutX="324.0" layoutY="102.0" stroke="BLACK" strokeType="INSIDE"
			width="139.0" />

		<!-- Etiqueta del campo nombre -->
		<Text fill="WHITE" layoutX="345.0" layoutY="122.0" text="Name :">
			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Text>

		<!-- Campo de entrada: nombre del jugador -->
		<TextField fx:id="txtNombre" layoutX="399.0" layoutY="102.0"
			prefHeight="32.0" prefWidth="199.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f);
			       -fx-background-radius: 40;
			       -fx-text-fill: white;
			       -fx-padding: 8 15 8 15;">

			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</TextField>

		<!-- BOTÓN: INICIAR SESIÓN -->
		<Button layoutX="387.0" layoutY="152.0"
			onAction="#iniciarSesion" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;"
			text="Iniciar Sesión" textFill="WHITE">

			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Button>

		<!-- Marco visual del campo ID -->
		<Rectangle arcHeight="40.0" arcWidth="40.0" height="31.0"
			layoutX="355.0" layoutY="192.0" stroke="BLACK" strokeType="INSIDE"
			width="139.0" />

		<!-- Etiqueta del campo ID -->
		<Text fill="WHITE" layoutX="368.0" layoutY="211.0" text="ID :">
			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Text>

		<!-- Campo de entrada: ID del jugador -->
		<TextField fx:id="txtId" layoutX="388.0" layoutY="191.0"
			prefHeight="32.0" prefWidth="185.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f);
			       -fx-background-radius: 40;
			       -fx-text-fill: white;
			       -fx-padding: 8 15 8 15;">

			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</TextField>

		<!-- TEXTO DE ERROR (VALIDACIONES DE LOGIN/REGISTRO) -->
		<Text fx:id="textoError" fill="RED" layoutX="360.0"
			layoutY="231.0" text="">

			<font>
				<Font name="MT Extra" size="12.0" />
			</font>
		</Text>

		<!-- BOTÓN: ENTRAR COMO INVITADO -->
		<Button layoutX="388.0" layoutY="248.0"
			onAction="#irAMenuJuego" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;"
			text="Jugar Como Invitado" textFill="WHITE">

			<font>
				<Font name="MT Extra" size="14.0" />
			</font>

			<cursor>
				<Cursor fx:constant="HAND" />
			</cursor>
		</Button>

		<!-- IMAGEN DEL TÍTULO DEL JUEGO -->
		<ImageView fitHeight="156.0" fitWidth="269.0"
			layoutX="332.0" layoutY="301.0">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Titulo.png" />
			</image>
		</ImageView>

	</children>
</AnchorPane>
