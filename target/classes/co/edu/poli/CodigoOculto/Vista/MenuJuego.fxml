<?xml version="1.0" encoding="UTF-8"?>

<!-- Librerías de JavaFX usadas en la interfaz -->

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<!-- Contenedor principal de la pantalla del menú del juego -->

<AnchorPane xmlns="http://javafx.com/javafx/23.0.1"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="co.edu.poli.CodigoOculto.Controlador.MenuJuegoControlador">

	<children>

		<!-- Imagen de fondo principal del menú -->
		<ImageView fitHeight="531.0" fitWidth="939.0">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/FondoGris.png" />
			</image>
		</ImageView>

		<!-- Cuadro decorativo central -->
		<ImageView fitHeight="272.0" fitWidth="278.0"
			layoutX="331.0" layoutY="53.0" opacity="0.88">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Cuadro1.png" />
			</image>
		</ImageView>

		<!-- Cuadro decorativo inferior derecho -->
		<ImageView fitHeight="111.0" fitWidth="187.0"
			layoutX="738.0" layoutY="406.0" opacity="0.88">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Cuadro1.png" />
			</image>
		</ImageView>

		<!-- BOTÓN: INICIAR JUEGO INDIVIDUAL -->
		<Button layoutX="391.0" layoutY="103.0"
			onAction="#irAPantallaJuego" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(to bottom, #24422D, #0B2010); -fx-background-radius: 40;"
			text="Jugar Solo" textFill="WHITE">

			<!-- Fuente del texto del botón -->
			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>

			<!-- Cursor tipo mano al pasar por el botón -->
			<cursor>
				<Cursor fx:constant="HAND" />
			</cursor>
		</Button>

		<!-- TEXTO: ID DEL JUGADOR -->
		<Text fx:id="textoId" fill="WHITE" layoutX="766.0"
			layoutY="437.0" text="ID :">

			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>
		</Text>

		<!-- TEXTO: NOMBRE DEL JUGADOR -->
		<Text fx:id="textoNombre" fill="WHITE" layoutX="766.0"
			layoutY="459.0" text="Name :">

			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>
		</Text>

		<!-- BOTÓN: MODO 1 VS 1 LOCAL -->
		<Button layoutX="391.0" layoutY="149.0"
			onAction="#irA1vs1Local" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(to bottom, #24422D, #0B2010); -fx-background-radius: 40;"
			text="1vs1 (Local)" textFill="WHITE">

			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>

			<cursor>
				<Cursor fx:constant="HAND" />
			</cursor>
		</Button>

		<!-- BOTÓN: VER HISTORIAL DEL JUGADOR -->
		<Button layoutX="391.0" layoutY="196.0"
			onAction="#irAHistorial" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(to bottom, #24422D, #0B2010); -fx-background-radius: 40;"
			text="Ver historial" textFill="WHITE">

			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>

			<cursor>
				<Cursor fx:constant="HAND" />
			</cursor>
		</Button>

		<!-- BOTÓN: INSTRUCCIONES DEL JUEGO -->
		<Button layoutX="391.0" layoutY="242.0"
			onAction="#irAComoJugar" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(to bottom, #24422D, #0B2010); -fx-background-radius: 40;"
			text="Como Jugar" textFill="WHITE">

			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>

			<cursor>
				<Cursor fx:constant="HAND" />
			</cursor>
		</Button>

		<!-- BOTÓN: CERRAR SESIÓN -->
		<Button layoutX="766.0" layoutY="472.0"
			onAction="#cerrarSesion" prefHeight="25.0" prefWidth="131.0"
			style="-fx-background-color: linear-gradient(to bottom, #24422D, #0B2010); -fx-background-radius: 40;"
			text="Cerrar Sesión" textFill="WHITE">

			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>

			<cursor>
				<Cursor fx:constant="HAND" />
			</cursor>
		</Button>

		<!-- IMAGEN DEL TÍTULO DEL JUEGO -->
		<ImageView fitHeight="156.0" fitWidth="269.0"
			layoutX="348.0" layoutY="300.0">

			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Titulo.png" />
			</image>
		</ImageView>

	</children>
</AnchorPane>
