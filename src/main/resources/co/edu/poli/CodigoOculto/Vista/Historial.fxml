<?xml version="1.0" encoding="UTF-8"?>

<!-- Vista del historial del jugador -->
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="co.edu.poli.CodigoOculto.Controlador.HistorialControlador">

	<children>

		<!-- Fondo -->
		<ImageView fitHeight="531.0" fitWidth="939.0">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/FondoVerde.png" />
			</image>
		</ImageView>

		<!-- Cuadro principal -->
		<ImageView fitHeight="468.0" fitWidth="502.0" layoutX="59.0"
			layoutY="32.0">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Cuadro1.png" />
			</image>
		</ImageView>

		<!-- Decoración superior -->
		<ImageView fitHeight="111.0" fitWidth="263.0"
			layoutX="615.0" layoutY="53.0">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Rectangulo1.png" />
			</image>
		</ImageView>

		<!-- Decoración inferior -->
		<ImageView fitHeight="73.0" fitWidth="174.0" layoutX="761.0"
			layoutY="455.0">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Rectangulo1.png" />
			</image>
		</ImageView>

		<!-- Título -->
		<ImageView fitHeight="188.0" fitWidth="309.0"
			layoutX="607.0" layoutY="190.0">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Titulo.png" />
			</image>
		</ImageView>

		<!-- ID jugador -->
		<Text fx:id="textoNombre" fill="WHITE" layoutX="679.0"
			layoutY="129.0" text="ID:">
			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>
		</Text>

		<!-- Nombre jugador -->
		<Text fx:id="textoNombre1" fill="WHITE" layoutX="678.0"
			layoutY="106.0" text="Name:">
			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>
		</Text>

		<!-- Estadísticas -->
		<Text fx:id="textoNombre11" fill="WHITE" layoutX="120.0"
			layoutY="157.0" text="Partidas jugadas:">
			<font>
				<Font name="Serif Bold" size="24.0" />
			</font>
		</Text>

		<Text fx:id="textoNombre111" fill="WHITE" layoutX="120.0"
			layoutY="199.0" text="Winrate:">
			<font>
				<Font name="Serif Bold" size="24.0" />
			</font>
		</Text>

		<Text fx:id="textoNombre112" fill="WHITE" layoutX="120.0"
			layoutY="293.0" text="Partidas ganadas:">
			<font>
				<Font name="Serif Bold" size="24.0" />
			</font>
		</Text>

		<Text fx:id="textoNombre1121" fill="WHITE" layoutX="120.0"
			layoutY="349.0" text="Partidas perdidas:">
			<font>
				<Font name="Serif Bold" size="24.0" />
			</font>
		</Text>

		<!-- Botón volver -->
		<Button layoutX="811.0" layoutY="479.0" onAction="#volverMenu"
			prefHeight="14.0" prefWidth="73.0" text="Volver" textFill="WHITE"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;">

			<font>
				<Font name="Serif Bold" size="14.0" />
			</font>
		</Button>

	</children>
</AnchorPane>
