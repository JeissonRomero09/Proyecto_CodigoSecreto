<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.text.*?>

<AnchorPane
    fx:controller="co.edu.poli.CodigoOculto.Controlador.PantallaJuegoControlador"
    prefHeight="463.0"
    prefWidth="689.0"
    xmlns="http://javafx.com/javafx/24"
    xmlns:fx="http://javafx.com/fxml/1"
    style="-fx-background-image: url('/co/edu/poli/CodigoOculto/Img/BlancoF.jpg');
           -fx-background-size: cover;
           -fx-background-position: center;">

    <children>

        <!-- TÍTULO -->
        <Text fill="#919191"
              layoutX="558.0"
              layoutY="28.0"
              text="Código Oculto">
            <font>
                <Font name="MT Extra" size="18.0"/>
            </font>
        </Text>

        <Text fill="WHITE"
              layoutX="560.0"
              layoutY="28.0"
              text="Código Oculto">
            <font>
                <Font name="MT Extra" size="18.0"/>
            </font>
        </Text>

        <!-- ID -->
        <Text fx:id="txtId"
              fill="#6e6e6e"
              layoutX="14.0"
              layoutY="28.0"
              text="ID :">
            <font>
                <Font name="MT Extra" size="18.0"/>
            </font>
        </Text>

        <!-- GRID CASILLAS (IGUAL AL TUYO) -->
        <GridPane fx:id="gridCasillas"
                  layoutX="222.0"
                  layoutY="55.0"
                  hgap="20.0"
                  vgap="20.0"
                  prefHeight="300.0"
                  prefWidth="300.0">

            <children>

                <!-- 5x5 EXACTO -->
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="4" GridPane.rowIndex="0"/>

                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="3" GridPane.rowIndex="1"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="4" GridPane.rowIndex="1"/>

                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="2" GridPane.rowIndex="2"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="3" GridPane.rowIndex="2"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="4" GridPane.rowIndex="2"/>

                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="3" GridPane.rowIndex="3"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="4" GridPane.rowIndex="3"/>

                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="2" GridPane.rowIndex="4"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="3" GridPane.rowIndex="4"/>
                <Button onMouseClicked="#seleccionarCasilla" GridPane.columnIndex="4" GridPane.rowIndex="4"/>

            </children>
        </GridPane>

        <!-- TECLADO NUMÉRICO -->
        <VBox layoutX="222.0" layoutY="357.0" spacing="5.0"
              style="-fx-background-color: black; -fx-padding: 8; -fx-background-radius: 3;">

            <children>

                <HBox alignment="CENTER" spacing="5.0">
                    <Button text="1" onAction="#presionarBoton"/>
                    <Button text="2" onAction="#presionarBoton"/>
                    <Button text="3" onAction="#presionarBoton"/>
                    <Button text="4" onAction="#presionarBoton"/>
                    <Button text="5" onAction="#presionarBoton"/>
                </HBox>

                <HBox alignment="CENTER" spacing="5.0">
                    <Button text="6" onAction="#presionarBoton"/>
                    <Button text="7" onAction="#presionarBoton"/>
                    <Button text="8" onAction="#presionarBoton"/>
                    <Button text="9" onAction="#presionarBoton"/>
                </HBox>

            </children>
        </VBox>

        <!-- ENTER -->
        <VBox layoutX="445.0" layoutY="370.0" spacing="5.0"
              style="-fx-background-color: black; -fx-padding: 8; -fx-background-radius: 3;">

            <children>
                <HBox alignment="CENTER">
                    <Button text="Enter" onAction="#presionarBoton"/>
                </HBox>
            </children>
        </VBox>

    </children>
</AnchorPane>