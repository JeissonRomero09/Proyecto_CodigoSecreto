<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane xmlns="http://javafx.com/javafx/25"
	xmlns:fx="http://javafx.com/fxml/1"
	fx:controller="co.edu.poli.CodigoOculto.Controlador.MenuJuegoControlador">

	<children>

		<ImageView fitHeight="531.0" fitWidth="939.0">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/F_V.jpeg" />
			</image>
		</ImageView>
		<ImageView fitHeight="272.0" fitWidth="278.0"
			layoutX="331.0" layoutY="53.0" opacity="0.88">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Cuadro.png" />
			</image>
		</ImageView>
		<ImageView fitHeight="111.0" fitWidth="187.0"
			layoutX="738.0" layoutY="406.0" opacity="0.88">
			<image>
				<Image url="@/co/edu/poli/CodigoOculto/Img/Cuadro.png" />
			</image>
		</ImageView>

		<!-- BOTÓN JUGAR -->
		<Button layoutX="391.0" layoutY="103.0"
			onAction="#irAPantallaJuego" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;"
			text="Jugar Solo" textFill="WHITE">
			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Button>

		<!-- ID DEL JUGADOR -->
		<Text fx:id="textoId" layoutX="766.0" layoutY="437.0" text="ID :">
			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Text>


		<Text fx:id="textoNombre" layoutX="766.0" layoutY="459.0"
			text="Name :">
			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Text>

		<!-- Local -->
		<Button layoutX="391.0" layoutY="149.0"
			onAction="#irA1vs1Local" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;"
			text="1vs1 (Local)" textFill="WHITE">

			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Button>

		<Button layoutX="391.0" layoutY="196.0" prefHeight="32.0"
			prefWidth="157.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;"
			text="Ver historial" textFill="WHITE">
			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Button>

		<Button layoutX="391.0" layoutY="242.0"
			onAction="#irAComoJugar" prefHeight="32.0" prefWidth="157.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;"
			text="Como Jugar" textFill="WHITE">

			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Button>

		<!-- CERRAR SESIÓN -->
		<Button layoutX="766.0" layoutY="472.0"
			onAction="#cerrarSesion" prefHeight="25.0" prefWidth="131.0"
			style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;"
			text="Cerrar Sesión" textFill="WHITE">
			<font>
				<Font name="MT Extra" size="14.0" />
			</font>
		</Button>

	</children>
</AnchorPane>
