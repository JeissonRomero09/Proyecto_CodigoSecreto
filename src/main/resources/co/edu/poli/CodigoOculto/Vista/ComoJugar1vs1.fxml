<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Cursor?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="471.0" prefWidth="958.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="co.edu.poli.CodigoOculto.Controlador.ComoJugarControlador">

    <!-- Imagen principal -->
    <ImageView fitHeight="523.0" fitWidth="617.0" layoutX="196.0" layoutY="-1.0">

        <image>
            <Image url="@/co/edu/poli/CodigoOculto/Img/ComoJugar3.png" />
        </image>

    </ImageView>

    <!-- Rectangulo -->
    <ImageView fitHeight="71.0" fitWidth="149.0" layoutX="809.0" layoutY="451.0">

        <image>
            <Image url="@/co/edu/poli/CodigoOculto/Img/Rectangulo1.png" />
        </image>

    </ImageView>

    <!-- Boton volver -->
    <Button layoutX="835.0" layoutY="474.0" onAction="#ir_1vs1_Local" prefHeight="28.0" prefWidth="91.0" style="-fx-background-color: linear-gradient(#4b4b4b, #1f1f1f); -fx-background-radius: 40;" text="Volver" textFill="WHITE">

        <font>
            <Font name="Serif Bold" size="12.0" />
        </font>

        <cursor>
            <Cursor fx:constant="HAND" />
        </cursor>

    </Button>
    <!-- Logo  -->
    <ImageView fitHeight="65.0" fitWidth="134.0" layoutX="8.0" layoutY="5.0">
		<image>
			<Image url="@/co/edu/poli/CodigoOculto/Img/Titulo.png" />
		</image>
	</ImageView>

</AnchorPane>
